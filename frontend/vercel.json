{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/genlayer-rpc.mjs": { "maxDuration": 30 } },
  "routes": [
    { "src": "/genlayer-rpc", "dest": "/api/genlayer-rpc" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
